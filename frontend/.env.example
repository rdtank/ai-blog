# Backend API origin used by production builds (no trailing slash).
# Leave this UNSET for local development — the Vite dev proxy forwards /api
# to http://localhost:3001 (see vite.config.ts).
#
# In production (Vercel), set it to your Railway backend URL, e.g.:
# VITE_API_URL=https://ai-blog-backend.up.railway.app
